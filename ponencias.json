---
layout: null
sitemap: false
---
{%- comment -%}
  Manifiesto generado por Jekyll en cada publicación de GitHub Pages.
  Lista los archivos estáticos bajo /ponencias/ y /anotaciones/;
  index.html filtra los .md y los .json.
  En Jekyll 3.10 «path» es la ruta relativa a la raíz con barra inicial.
{%- endcomment -%}
{%- assign archivos = site.static_files | where_exp: "f", "f.path contains '/ponencias/'" | sort: "path" -%}
{%- assign notas = site.static_files | where_exp: "f", "f.path contains '/anotaciones/'" | sort: "path" -%}
{"forjaPonencias":"2","generado":{{ site.time | date_to_xmlschema | jsonify }},"ponencias":[
{%- for f in archivos -%}
{"ruta":{{ f.path | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
],"anotaciones":[
{%- for f in notas -%}
{"ruta":{{ f.path | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]}
